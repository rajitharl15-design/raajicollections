{
  "name": "raaji-collections-backend",
  "version": "1.0.0",
  "description": "Backend API for Raaji Collections e-commerce website",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:schema": "psql -d raaji_collections -f database/schema.sql",
    "db:seed": "psql -d raaji_collections -f database/seed.sql"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  }
}
